{
  "manifest_version": 3,
  "name": "Ultimate Bookmark Manager",
  "version": "1.0.0",
  "description": "A bookmark manager for Chrome browser bookmarks.",
  "permissions": [
    "bookmarks",
    "storage",
    "downloads",
    "declarativeNetRequest",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/bookmark-manager-16.png",
      "32": "icons/bookmark-manager-32.png",
      "48": "icons/bookmark-manager-48.png",
      "128": "icons/bookmark-manager-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/bookmark-manager-16.png",
    "32": "icons/bookmark-manager-32.png",
    "48": "icons/bookmark-manager-48.png",
    "128": "icons/bookmark-manager-128.png"
  }
}
